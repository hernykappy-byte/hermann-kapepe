# Required in production. Signs round tokens so scores cannot be forged.
# Generate with: openssl rand -base64 48
GRRAND_SECRET=

# Optional. Any Postgres connection string (for Supabase use the pooled "Transaction" string
# from Project Settings > Database). Turns on accounts, ranks, teams and the live player count.
# The tables are created automatically on first use. Without it the game still plays and
# keeps personal stats on the device, and those screens say "Needs setup".
DATABASE_URL=

# Optional. Used only by /api/admin/generate to draft new questions with Gemini.
GEMINI_API_KEY=
# Bearer token (16+ chars) that protects /api/admin/generate. Unset = endpoint off.
ADMIN_TOKEN=

# Public site URL, used for share links and metadata.
NEXT_PUBLIC_SITE_URL=
# Optional. Lets Claude fact-check Gemini's drafts before a human reviews them.
ANTHROPIC_API_KEY=
